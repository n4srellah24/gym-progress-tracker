# GitHub Fine-Grained Personal Access Token (PAT)
# Scope needed: 'Contents' repository permissions (Read and Write) for your target repo
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username or organization name
GITHUB_OWNER=your_github_username

# Your target training log repository name
GITHUB_REPO=training-log

# Git branch to commit session JSON files to (default: main)
GITHUB_BRANCH=main

# Directory path inside repository where workout JSON files land
GITHUB_INBOX_PATH=data/inbox
